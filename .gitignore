# Python bytecode — compiled artifacts never belong in the repo (added 2026-10-06)
__pycache__/
*.py[cod]

# Lint and test caches — the release packer has always dropped these
# from cuts; the repo ignores them for the same reason (added 2026-10-07)
.ruff_cache/
.pytest_cache/

# Jupyter checkpoint copies (added 2026-10-07)
.ipynb_checkpoints/

# User output, written at the repo root by ion_gym.io.paths: saved
# solved fields, saved trajectory NPZs, and generated figures/reports.
# Flight output is data, not source (trajectories/ has been excluded
# since 2026-09-29; fields/ and outputs/ are the same class).
# notebooks/panels/ is NOT ignored: the banked instrument panels are
# shipped content the teaching notebooks display on open.
fields/
trajectories/
outputs/

# Claude session context — never ships, never commits (the rule that
# followed the 2026-09-29 dev-branch scrub)
.claude/

# pip install -e . artifacts (the notebooks recommend an editable
# install from the repo root)
*.egg-info/
build/
dist/

# macOS Finder metadata
.DS_Store
