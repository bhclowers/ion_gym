# ion_gym -- files a checkout generates while you work.
# Everything ignored here is rebuildable state written by the package,
# the dashboard or the notebooks; none of it is source.

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# tool caches
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# solved fields, exported fields and saved runs (per-machine results,
# regenerated by solving or re-flying the deck)
fields/
exported_field_*.npz
trajectories/

# figures, reports and study output written by the framework
outputs/

# notebook scratch (variant decks and run artifacts the notebooks write;
# notebooks/panels/ is shipped content and stays tracked)
notebooks/out/

# files installed through the dashboard's upload doors
uploads/

# editors, OS and agent configuration
.DS_Store
.vscode/
.idea/
.claude/
